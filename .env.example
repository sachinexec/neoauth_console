# Template for .env.dev and .env.prod (one per --flavor). The real files are
# bundled as assets but not committed; copy this and fill it in.
APP_ENV=dev
# The dev auth service. "localhost" is rewritten to 10.0.2.2 on the Android
# emulator. Point this at the deployed dev service (https://neoauth-dot-….appspot.com)
# to use the dev project instead of your machine.
NEOAUTH_ISSUER=http://localhost:3000
# From `npm run console -- bootstrap` against the dev auth service.
NEOAUTH_CLIENT_ID=neoauth-console.native.XXXX
